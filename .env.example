# Which simulation (sims/<name>) runs, and whether it's paused; sims/live.js has the defaults
# SIM=aquarium
PAUSED=0

# Fish art (drawn on fal when each fish hatches)
FAL_API_KEY=

# The mind's model: any OpenAI-compatible endpoint with tool calling
BRAIN_URL=http://localhost:8000/v1
BRAIN_KEY=
BRAIN_MODEL=deepseek-v4-flash-vision-exp
# Cloudflare Access service-token headers, if the endpoint sits behind Cloudflare Access
BRAIN_CF_ID=
BRAIN_CF_SECRET=
# BRAIN_THINKING=1        # reason before each turn: richer but much slower conversation
# BRAIN_THINK_BUDGET=800  # reasoning tokens per decision when thinking (needs vLLM's thinking_token_budget)

# Shared secret between the sim and the mind (any long random string)
MIND_TOKEN=
# SIM_URL=ws://localhost:8080/mind
# MIND_CONCURRENCY=6

# Where the tank, its history and the fish art are kept
# DATA_DIR=data
