{
  "name": "lbl",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n sim,web,mind \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:mind\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "dev:mind": "uv run --project mind python mind/main.py",
    "build": "vite build client --outDir ../dist",
    "start": "node server/index.js"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "phaser": "^4.2.1",
    "vite": "^8.3.5"
  }
}
